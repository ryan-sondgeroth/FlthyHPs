(footprint "Converter_DCDC_Pololu_D42V55F5" (version 20211014) (generator pcbnew)
  (layer "F.Cu")
  (descr "Pololu D42V55F5 5V 5.5A Step-Down Regulator, 25.4x21.1mm, 2x6 pads 1.27mm pitch")
  (tags "pololu regulator buck 5V D42V55F5")
  (attr through_hole)

  (fp_text reference "REF**" (at 0 -13.5 0) (layer "F.SilkS")
    (effects (font (size 1.27 1.27) (thickness 0.15)))
  )
  (fp_text value "Pololu_D42V55F5" (at 0 13.5 0) (layer "F.Fab")
    (effects (font (size 1.27 1.27) (thickness 0.15)))
  )

  (fp_line (start -12.7 -10.55) (end 12.7 -10.55) (layer "F.CrtYd") (width 0.05))
  (fp_line (start 12.7 -10.55) (end 12.7 10.55) (layer "F.CrtYd") (width 0.05))
  (fp_line (start 12.7 10.55) (end -12.7 10.55) (layer "F.CrtYd") (width 0.05))
  (fp_line (start -12.7 10.55) (end -12.7 -10.55) (layer "F.CrtYd") (width 0.05))

  (fp_line (start -12.7 -10.55) (end 12.7 -10.55) (layer "F.Fab") (width 0.1))
  (fp_line (start 12.7 -10.55) (end 12.7 10.55) (layer "F.Fab") (width 0.1))
  (fp_line (start 12.7 10.55) (end -12.7 10.55) (layer "F.Fab") (width 0.1))
  (fp_line (start -12.7 10.55) (end -12.7 -10.55) (layer "F.Fab") (width 0.1))

  (fp_line (start -12.7 -10.55) (end 12.7 -10.55) (layer "F.SilkS") (width 0.12))
  (fp_line (start -12.7 10.55) (end 12.7 10.55) (layer "F.SilkS") (width 0.12))

  (fp_3dmodel "${KIPRJMOD}/kicad_libraries/3d_models/d42v55fx-step-down-voltage-regulator.step"
    (offset (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )

  ; Row 1 (inner row) — left side of board edge
  ; Pads: PG, EN, VIN, GND, VOUT, VOUT  (positions at y = -3.175 relative to center)
  ; Row 2 (outer row) — right side of board edge
  ; Pads: VRP, GND, VIN, GND, VOUT, VOUT (positions at y = +3.175 relative to center)
  ; X positions: -3.175, -1.905, -0.635, 0.635, 1.905, 3.175 (1.27mm pitch, centered)

  (pad "PG" thru_hole circle (at -3.175 -3.175) (size 1.524 1.524) (drill 1.02) (layers "*.Cu" "*.Mask")
    (net 0 "")
  )
  (pad "EN" thru_hole circle (at -1.905 -3.175) (size 1.524 1.524) (drill 1.02) (layers "*.Cu" "*.Mask")
    (net 0 "")
  )
  (pad "VIN2" thru_hole circle (at -0.635 -3.175) (size 1.524 1.524) (drill 1.02) (layers "*.Cu" "*.Mask")
    (net 0 "")
  )
  (pad "GND3" thru_hole circle (at 0.635 -3.175) (size 1.524 1.524) (drill 1.02) (layers "*.Cu" "*.Mask")
    (net 0 "")
  )
  (pad "OUT1" thru_hole circle (at 1.905 -3.175) (size 1.524 1.524) (drill 1.02) (layers "*.Cu" "*.Mask")
    (net 0 "")
  )
  (pad "OUT2" thru_hole circle (at 3.175 -3.175) (size 1.524 1.524) (drill 1.02) (layers "*.Cu" "*.Mask")
    (net 0 "")
  )

  (pad "VRP" thru_hole circle (at -3.175 3.175) (size 1.524 1.524) (drill 1.02) (layers "*.Cu" "*.Mask")
    (net 0 "")
  )
  (pad "GND4" thru_hole circle (at -1.905 3.175) (size 1.524 1.524) (drill 1.02) (layers "*.Cu" "*.Mask")
    (net 0 "")
  )
  (pad "VIN" thru_hole circle (at -0.635 3.175) (size 1.524 1.524) (drill 1.02) (layers "*.Cu" "*.Mask")
    (net 0 "")
  )
  (pad "GND1" thru_hole circle (at 0.635 3.175) (size 1.524 1.524) (drill 1.02) (layers "*.Cu" "*.Mask")
    (net 0 "")
  )
  (pad "GND2" thru_hole circle (at 1.905 3.175) (size 1.524 1.524) (drill 1.02) (layers "*.Cu" "*.Mask")
    (net 0 "")
  )
  (pad "OUT3" thru_hole circle (at 3.175 3.175) (size 1.524 1.524) (drill 1.02) (layers "*.Cu" "*.Mask")
    (net 0 "")
  )

  ; Mounting holes
  (pad "P1" thru_hole circle (at -10.16 -8.89) (size 3.4 3.4) (drill 2.18) (layers "*.Cu" "*.Mask"))
  (pad "P2" thru_hole circle (at -10.16 8.89) (size 3.4 3.4) (drill 2.18) (layers "*.Cu" "*.Mask"))
  (pad "P3" thru_hole circle (at 10.16 -8.89) (size 3.4 3.4) (drill 2.18) (layers "*.Cu" "*.Mask"))
)
