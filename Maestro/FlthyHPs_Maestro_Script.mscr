  5864 2 servo        # ch2 = 1466us
  7092 3 servo        # ch3 = 1773us
  quit

sub hp2_left          # subroutine 12
  6820 2 servo        # ch2 = 1705us
  6392 3 servo        # ch3 = 1598us
  quit

sub hp2_upper_left    # subroutine 13
  6820 2 servo        # ch2 = 1705us
  7188 3 servo        # ch3 = 1797us
  quit

sub hp2_lower_left    # subroutine 14
  6820 2 servo        # ch2 = 1705us
  5556 3 servo        # ch3 = 1389us
  quit

sub hp2_right         # subroutine 15
  5144 2 servo        # ch2 = 1286us
  5840 3 servo        # ch3 = 1460us
  quit

sub hp2_upper_right   # subroutine 16
  5144 2 servo        # ch2 = 1286us
  6408 3 servo        # ch3 = 1602us
  quit

sub hp2_lower_right   # subroutine 17
  5140 2 servo        # ch2 = 1285us
  5132 3 servo        # ch3 = 1283us
  quit

# --- HP3 (Top)  channels 4, 5 ---

sub hp3_center        # subroutine 18
  6028 4 servo        # ch4 = 1507us
  4832 5 servo        # ch5 = 1208us
  quit

sub hp3_up            # subroutine 19
  6004 4 servo        # ch4 = 1501us
  5868 5 servo        # ch5 = 1467us
  quit

sub hp3_down          # subroutine 20
  5772 4 servo        # ch4 = 1443us
  6720 5 servo        # ch5 = 1680us
  quit

sub hp3_left          # subroutine 21
  6496 4 servo        # ch4 = 1624us
  5872 5 servo        # ch5 = 1468us
  quit

sub hp3_upper_left    # subroutine 22
  6496 4 servo        # ch4 = 1624us
  6668 5 servo        # ch5 = 1667us
  quit

sub hp3_lower_left    # subroutine 23
  6612 4 servo        # ch4 = 1653us
  5088 5 servo        # ch5 = 1272us
  quit

sub hp3_right         # subroutine 24
