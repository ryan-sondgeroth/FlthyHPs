# ============================================================
# FlthyHPs Maestro Script
# by Ryan Sondgeroth / FlthyMcNsty
#
# 3 HPs x 9 positions = 27 subroutines
# Subroutine index = (hp * 9) + position
#   HP1 (Front) = subroutines  0 -  8   channels 0, 1
#   HP2 (Rear)  = subroutines  9 - 17   channels 2, 3
#   HP3 (Top)   = subroutines 18 - 26   channels 4, 5
#
# Position layout (matches HP_POSITIONS order in sketch):
#   0 = center
#   1 = up
#   2 = down
#   3 = left
#   4 = upper-left
#   5 = lower-left
#   6 = right
#   7 = upper-right
#   8 = lower-right
#
# Values are in quarter-microseconds (us x 4).
# 1500us center = 6000 quarter-us.
#
# To calibrate: use Maestro Control Center Status tab sliders
# to jog each servo pair to each desired position, note the
# pulse width values, multiply by 4, and update below.
# No sketch changes needed after updating this file.
# ============================================================

# --- HP1 (Front)  channels 0, 1 ---

ququitsquitreub hp1_center        # subroutine 0
  5508 0 servo        # ch0 = 1377us
  6824 1 servo        # ch1 = 1706us
  quit

sub hp1_up            # subroutine 1
  5908 0 servo        # ch0 = 1477us
  5704 1 servo        # ch1 = 1426us
  quit

sub hp1_down          # subroutine 2
  5688 0 servo        # ch0 = 1422us
  4644 1 servo        # ch1 = 1161us
  quit

sub hp1_left          # subroutine 3
  6444 0 servo        # ch0 = 1611us
  5700 1 servo        # ch1 = 1425us
  quit

sub hp1_upper_left    # subroutine 4
  6444 0 servo        # ch0 = 1611us
  4620 1 servo        # ch1 = 1155us
  quit

sub hp1_lower_left    # subroutine 5
  6444 0 servo        # ch0 = 1611us
  6956 1 servo        # ch1 = 1739us
  quit

sub hp1_right         # subroutine 6
  5020 0 servo        # ch0 = 1255us
  5736 1 servo        # ch1 = 1434us
  quit

sub hp1_upper_right   # subroutine 7
  5020 0 servo        # ch0 = 1255us
  4460 1 servo        # ch1 = 1115us
  quit

sub hp1_lower_right   # subroutine 8
  5020 0 servo        # ch0 = 1255us
  6916 1 servo        # ch1 = 1729us
  quit

